# Backend API host — no scheme, no path, no trailing slash.
# Defaults to localhost:8000 (the Rust simulation server) if unset.
# In production this is set via the Cloudflare Pages / GitHub Actions secrets.
VITE_API_BASE=localhost:8000

# Absolute URL of the dynamic Open Graph image endpoint. Social
# crawlers (WhatsApp, Twitter, Discord, …) fetch this when someone
# shares a link, so it has to be reachable from the public internet.
# The simulation server exposes /og.png; point this at the public
# URL of that endpoint. Defaults to the public production URL if
# unset by Vite during build.
# Same-origin path (proxied via client/functions/og.png.ts on
# Cloudflare Pages → api.thehumanbox.com/og.png). Same-origin
# silences SEO validators that flag cross-host og:image as
# "invalid", and lets the edge cache the response on our host.
VITE_OG_IMAGE_URL=https://thehumanbox.com/og.png
