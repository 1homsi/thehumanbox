{
  "name": "thehumanbox-desktop",
  "productName": "The Human Box RU",
  "version": "0.6.14",
  "private": true,
  "description": "The Human Box RU — Russian fork of The Human Box. Runs the simulation locally.",
  "homepage": "https://github.com/alklimover/thehumanbox",
  "author": {
    "name": "alklimover"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "test:main": "pnpm run build:main && node --test dist/main/*.test.js",
    "build:renderer": "cd ../web && cross-env VITE_DESKTOP=1 pnpm run build",
    "build": "pnpm run build:main && pnpm run build:renderer && pnpm run copy:renderer",
    "copy:renderer": "rm -rf dist/renderer && cp -R ../web/dist dist/renderer",
    "dev": "pnpm run build:main && electron .",
    "pack": "pnpm run build && electron-builder --publish never",
    "release": "pnpm run build && electron-builder --publish always",
    "clean": "rm -rf dist out"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "cross-env": "^10.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "typescript": "^5.7.2"
  }
}
