# Copy this to .env and fill in real values. dotenvy loads it at sim
# startup. Do NOT commit your real .env - it's gitignored.

# ── LLM lanes ─────────────────────────────────────────────────────────────
#
# The sim splits LLM traffic into two lanes:
#
#   - narration: longer, story-quality prose for the daily life-log
#     summaries. Off the user-visible critical path. Tolerates 100-300ms
#     latency. Defaults to Groq's hosted llama-3.1-8b-instant.
#
#   - think: short, terse first-person thoughts that drive in-game
#     decisions. ON the visible path - every tick. Wants sub-50ms
#     latency. This can point at a local llama.cpp or Ollama server.
#
# Each lane resolves its env in this order:
#   {LANE}_LLM_URL  -> LLM_URL  -> hardcoded default (Groq)
#   {LANE}_LLM_KEY  -> LLM_KEY  -> GROQ_API_KEY  -> empty
#   {LANE}_LLM_MODEL -> LLM_MODEL -> "llama-3.1-8b-instant"
#
# Single-lane setup (dev box, both lanes hit one endpoint): set LLM_URL /
# LLM_MODEL / LLM_KEY only. Both lanes follow.
#
# Dual-lane setup: set the lane-specific vars
# below. The fallback to LLM_* is what lets you mix and match.

# ── Dev box: single-lane Ollama (uncomment to use) ────────────────────────
# LLM_URL=http://localhost:11434/v1/chat/completions
# LLM_MODEL=gemma3:270m
# LLM_KEY=ollama-local

# ── Dual-lane example (narration on Groq, think on local llama.cpp) ───────
#
# Lane A - narration via Groq:
NARRATION_LLM_URL=https://api.groq.com/openai/v1/chat/completions
NARRATION_LLM_MODEL=llama-3.1-8b-instant
NARRATION_LLM_KEY=gsk_REPLACE_ME_with_your_groq_api_key

# Lane B - think via local llama.cpp (port 8080 on the same box):
THINK_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
THINK_LLM_MODEL=gemma-3-270m-it
THINK_LLM_KEY=local

# ── Transport / tick cadence ──────────────────────────────────────────────
# Defaults are fine for most machines but exposed here for tuning.
# TICK_MS=100
# NETWORK_MS=200
# LOOKAHEAD_MS=150

# ── Rate limits ───────────────────────────────────────────────────────────

# Per-minute cap for Groq narration calls. Groq's free tier is 30 RPM;
# we stay just under to absorb retries. Default: 28.
# GROQ_RPM=28

# Per-minute cap for the local llama.cpp think lane. Prevents tick bursts
# from flooding llama.cpp's per-slot KV cache and OOM'ing the box.
# Default: 240 (4/s).
# LOCAL_THINK_RPM=240

# ── Memory watchdog ───────────────────────────────────────────────────────
# Machine-wide floors checked against /proc/meminfo MemAvailable. When the
# simulation, model server, and OS drop below these, the sim throttles LLM work.

# Elevated throttle threshold in MB available. Default: 400.
# MEM_FLOOR_ELEVATED_MB=400

# Critical throttle threshold in MB available. Default: 200.
# MEM_FLOOR_CRITICAL_MB=200

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated extra origins to allow (in addition to the hardcoded
# thehumanbox.com + localhost dev hosts). Useful for staging deploys.
# THB_EXTRA_CORS_ORIGINS=https://staging.thehumanbox.com,https://preview.thehumanbox.com

# ── Logging ───────────────────────────────────────────────────────────────
# tracing_subscriber EnvFilter. Default if unset:
# "info,reqwest=warn,hyper=warn,h2=warn". Raise specific targets to debug
# a subsystem, e.g. "info,groq=debug,think=debug".
# RUST_LOG=info,reqwest=warn,hyper=warn,h2=warn
