# Example systemd unit for llama-server. Manual install per our infra
# convention - do NOT add this to any deploy automation.
#
#   sudo cp scripts/llama-server.service.example /etc/systemd/system/llama-server.service
#   # edit User= and the ExecStart path if you changed LLAMA_CPP_DIR
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now llama-server
#   sudo journalctl -u llama-server -f
#
# Listens only on 127.0.0.1:8080 so it's reachable from the sim
# process on the same box but not from the public internet. Don't
# bind 0.0.0.0 - llama-server has no auth, anything reachable can
# burn your CPU.
#
# Low-memory profile for running Gemma alongside the simulation on a
# burstable instance. It deliberately allows only one decode slot and
# quantizes the KV cache; raise these limits only after measuring RSS.

[Unit]
Description=llama.cpp inference server (gemma-3-270m-it Q4_K_M)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/llama.cpp

# --host 127.0.0.1 is critical: keep this loopback-only.
# Thought prompts are short, so a 1024-token context avoids reserving a
# large KV cache that requests never use.
ExecStart=/home/ubuntu/llama.cpp/build/bin/llama-server \
  --model /home/ubuntu/llama.cpp/models/gemma-3-270m-it-Q4_K_M.gguf \
  --host 127.0.0.1 \
  --port 8080 \
  --ctx-size 1024 \
  --parallel 1 \
  --batch-size 128 \
  --ubatch-size 64 \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --threads 1

Restart=on-failure
RestartSec=5

# Resource cap so inference cannot starve or OOM the simulation.
CPUQuota=80%
MemoryHigh=600M
MemoryMax=700M
TasksMax=64

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/llama.cpp/models
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
