     expect(run().uploads).toEqual([])
   })
 
+  it('uses the one-pass pack for a hot layer and keeps retained mappings for sparse updates', () => {
+    const { rs, run } = setup()
+    const l = make()
+    for (let i = 0; i < 100; i++) l.add(i, 5, 8, 8)
+    rs.addSpriteLayer(l)
+    run()
+
+    for (let i = 0; i < l.count; i++) l.x[i] += 1
+    l.touch()
+    const hot = run()
+    expect(hot.uploads.reduce((sum, upload) => sum + upload.floats, 0)).toBe(100 * F)
+
+    for (let i = 0; i < l.count; i++) l.x[i] += 1
+    l.touch()
+    const blind = run()
+    expect(blind.uploads.reduce((sum, upload) => sum + upload.floats, 0)).toBe(100 * F)
+
+    l.x[5] += 1
+    l.touchRange(5)
+    const sparse = run()
+    expect(sparse.uploads).toEqual([{ off: 5 * F * 4, floats: F }])
+    expect(sparse.draws[5 * F]).toBe(8)
+  })
+
